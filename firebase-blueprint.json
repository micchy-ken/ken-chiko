{
  "entities": {
    "UserProgress": {
      "title": "UserProgress",
      "description": "Lightweight user game progress, companion state, discovery status, inventory, and diary",
      "type": "object",
      "properties": {
        "version": {
          "type": "number",
          "description": "Schema version number"
        },
        "kenchiko": {
          "type": "object",
          "description": "Current status and location of Kenchiko"
        },
        "nyanProgress": {
          "type": "object",
          "description": "Map of user character discoveries and customizations keyed by nyan number"
        },
        "inventory": {
          "type": "array",
          "description": "User inventory items and quantities"
        },
        "diary": {
          "type": "array",
          "description": "Capped recent diary logs (max 30 entries)"
        },
        "asobiList": {
          "type": "array",
          "description": "User custom asobi actions and monologues"
        },
        "ouenCategories": {
          "type": "array",
          "description": "Custom ouen cheer mood categories"
        },
        "ouenList": {
          "type": "array",
          "description": "Custom ouen cheer messages"
        },
        "kihonNyanCustomImageUrl": {
          "type": "string",
          "description": "Custom image URL for Kihon Nyan"
        },
        "googleDriveFolderUrl": {
          "type": "string",
          "description": "Configured Google Drive folder URL for character images"
        },
        "stats": {
          "type": "object",
          "description": "Aggregate gameplay statistics"
        },
        "rewards": {
          "type": "object",
          "description": "User points, reward tickets, initial bonus flag, and daily claim states"
        },
        "lastSaved": {
          "type": "number",
          "description": "Timestamp of last save"
        },
        "updatedAt": {
          "type": "string",
          "description": "ISO timestamp of last write"
        }
      },
      "required": ["version", "kenchiko", "lastSaved"]
    },
    "NyankoStory": {
      "title": "NyankoStory",
      "description": "Weekly story, lore, and dialogue for an individual nyan character",
      "type": "object",
      "properties": {
        "id": {
          "type": "number",
          "description": "Character No / ID"
        },
        "name": {
          "type": "string",
          "description": "Character name"
        },
        "kana": {
          "type": "string",
          "description": "Character reading kana"
        },
        "motif": {
          "type": "string",
          "description": "Motif description"
        },
        "debut_date": {
          "type": "string",
          "description": "Debut date"
        },
        "voice": {
          "type": "string",
          "description": "Cat cry / sound"
        },
        "translation": {
          "type": "string",
          "description": "Cat translation"
        },
        "episode_summary": {
          "type": "string",
          "description": "Summary of this character's story episode"
        },
        "prompt_ja": {
          "type": "string",
          "description": "Image prompt in Japanese"
        },
        "prompt_en": {
          "type": "string",
          "description": "Image prompt in English"
        },
        "doc_link": {
          "type": "string",
          "description": "Google Doc reference link"
        },
        "week_info": {
          "type": "object",
          "description": "Weekly dialogue messages and dates"
        },
        "updatedAt": {
          "type": "string",
          "description": "ISO timestamp of last update"
        }
      },
      "required": ["id", "name"]
    },
    "MasterMeta": {
      "title": "MasterMeta",
      "description": "Version metadata for the global nyan character master database",
      "type": "object",
      "properties": {
        "version": {
          "type": "number",
          "description": "Monotonically increasing master version"
        },
        "updatedAt": {
          "type": "number",
          "description": "Timestamp in ms of last publish"
        },
        "nyanCount": {
          "type": "number",
          "description": "Total count of active characters in the master"
        },
        "lastUpdatedNote": {
          "type": "string",
          "description": "Optional notes or changelog"
        }
      },
      "required": ["version", "updatedAt", "nyanCount"]
    },
    "MasterNyans": {
      "title": "MasterNyans",
      "description": "Consolidated master character database document with resolved images and attributes",
      "type": "object",
      "properties": {
        "version": {
          "type": "number",
          "description": "Matching version number"
        },
        "updatedAt": {
          "type": "number",
          "description": "Timestamp in ms"
        },
        "nyans": {
          "type": "array",
          "description": "Array of complete master NyanCharacter definitions"
        }
      },
      "required": ["version", "updatedAt", "nyans"]
    }
  },
  "firestore": {
    "/kenchiko_world/{docId}": {
      "schema": "UserProgress",
      "description": "User game state and progress document in the kenchiko_world collection"
    },
    "/kenchiko_world/ken-chiko-master-meta": {
      "schema": "MasterMeta",
      "description": "Master version metadata checked by clients on launch"
    },
    "/kenchiko_world/ken-chiko-master-nyans": {
      "schema": "MasterNyans",
      "description": "Consolidated character master database pushed by administrators"
    },
    "/nyanko_stories/{storyId}": {
      "schema": "NyankoStory",
      "description": "Story and dialogue archives for each nyan character keyed by character ID"
    }
  }
}

